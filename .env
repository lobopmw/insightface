# PostgreSQL connection (local dev; containers sobrepõem conforme Compose)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=insightface_db
DB_USER=insightface_user
DB_PASSWORD=insightface_password

# Relay client defaults (Streamlit acessa o socket do relay)
RELAY_HOST=127.0.0.1
RELAY_PORT=5555

# Ajustes opcionais do relay (refletidos no docker-compose)
RELAY_QUALITY=85
RELAY_SEND_FPS=15

# URL da câmera RTSP utilizada pelo relay
RTSP_URL=rtsp://admin:admin124@172.16.5.40:554/Streaming/Channels/101
